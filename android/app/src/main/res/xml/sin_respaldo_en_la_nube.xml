<?xml version="1.0" encoding="utf-8"?>
<!-- Los datos quedan solo en el celular: nada de respaldo automático en la nube ni copia a otro equipo.
     El respaldo lo hace la persona desde Perfil (archivo o texto). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
